# Godot 4+ specific ignores
.godot/
.godot_user/
/android/
# GDExtension hot-reload temp copies (Godot renames the loaded .dll to ~*.dll on Windows)
~*.dll
~*.dll*.TMP

# Local assistant/session files
.codex/
.claude/settings.local.json
AGENTS.md
CLAUDE.md

# Build/export outputs
/build/*
!/build/windows/
/exports/

# Project notes and generated reports kept out of public source.
# docs/ is its own private git repo (docs/.git); AGENTS.md / CLAUDE.md at root are untracked stubs.
/docs/
/reports/

# Logs
*.log

# Local database (runtime save data)
*.sqlite
/data/state_store.db/

# Python build/cache artifacts
__pycache__/
*.pyc

# 検証用の一時スクショ/クロップ/スクリプト (リポジトリ直下の throwaway)
/_shot_*
/_crop_*
/_warnscan.*

# 配布用ZIPの出力先 (リリース資材、Git管理しない)
/dist/
